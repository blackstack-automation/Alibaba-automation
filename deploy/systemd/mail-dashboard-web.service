[Unit]
Description=Mail Dashboard (gunicorn web)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__
# One process + many threads: the live job page holds an SSE connection open per
# viewer, which needs threads.
ExecStart=__APP_DIR__/venv/bin/gunicorn --worker-class gthread --workers 1 --threads 16 --timeout 120 --bind 127.0.0.1:8000 --access-logfile - wsgi:app
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
